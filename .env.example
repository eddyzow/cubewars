# Copy to .env and fill in real values. Do not commit .env.
#
# Port for local dev. Heroku sets this itself, so it is dev-only.
PORT=3001
#
# MongoDB Atlas connection string for the `cubewars` database (replays only).
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority&appName=cubewars
#
# MongoDB Atlas connection string for the eddyzow.net account cluster. Accounts
# are shared across every app on the site; this server reads db "users",
# collection "users". Must be the same cluster the eddyzow.net portal writes to.
ACCOUNTS_MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
#
# Secret used to sign login JWTs. MUST match the secret the eddyzow.net portal
# signs with, or portal sessions will not verify here.
JWT_SECRET=
