# Copy to .env and fill in real values. Do not commit .env.
#
# Port for local dev. Heroku sets this itself, so it is dev-only.
PORT=3001
#
# MongoDB Atlas connection string for the `cubewars` database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority&appName=cubewars
#
# Secret used to sign login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
